# 3D ULPIN Project Environment Variables

# If you choose to use advanced LLMs (e.g. OpenAI GPT-4 Vision, Anthropic, or external OCR) 
# instead of the built-in deterministic OpenCV/Tesseract and regex NLP models,
# you can supply your API keys below.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# The AI pipeline will automatically detect the presence of these keys.
# If they are not found, the system will seamlessly run 100% locally
# using the offline CV/NLP algorithms (zero external dependencies).
